---
const today = new Date();
---

<footer>
	<nav class="cols" aria-label="Footer">
		<div>
			<h4>Site</h4>
			<a href="/">Home</a>
			<a href="/blog/">Blog</a>
			<a href="/portfolio/">Portfolio</a>
			<a href="/about/">About</a>
			<a href="/rss.xml">RSS</a>
		</div>
		<div>
			<h4>Things I run</h4>
			<a href="https://status.jimmyhoughjr.net">Status</a>
			<a href="https://watts.jimmyhoughjr.net">Watts</a>
			<a href="https://head2head.jimmyhoughjr.net">head2head</a>
			<a href="https://docs.jimmyhoughjr.net">docs</a>
		</div>
	</nav>
	<p class="copy">&copy; {today.getFullYear()} Jimmy Hough Jr. All rights reserved. · <a href="https://github.com/jhoughjr/roost" set:html={`<svg width="13" height="13" viewBox="0 0 64 64" fill="currentColor" style="vertical-align:-2px;margin-right:2px" aria-hidden="true"><path d="M19 39 C5 34 2 18 9 7 C9.5 21 14 31 24 33 Z"/><path d="M22 33 C13 29 11 19 15 11 C16 21 19 27 27 29 Z"/><ellipse cx="29" cy="33" rx="13" ry="11"/><path d="M35 17 L45 25 L36 33 L26 25 Z"/><circle cx="43" cy="18" r="5.7"/><circle cx="40.5" cy="11" r="2.9"/><circle cx="45" cy="11.8" r="2.4"/><path d="M48.2 15.8 L55 18.2 L48.2 20.8 Z"/><rect x="26.6" y="42" width="2.6" height="10" rx="1.3"/><rect x="32.8" y="42" width="2.6" height="10" rx="1.3"/><rect x="7" y="50.5" width="50" height="3" rx="1.5"/></svg>Powered by Roost`}></a></p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: var(--text-color);
		text-align: center;
	}
	.cols {
		display: flex;
		justify-content: center;
		gap: 4em;
		text-align: left;
		margin-bottom: 1.5em;
	}
	.cols h4 {
		margin: 0 0 0.4em;
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.6;
	}
	.cols a {
		display: block;
		color: var(--text-color);
		text-decoration: none;
		padding: 0.15em 0;
	}
	.cols a:hover {
		color: var(--accent);
	}
	.copy {
		margin: 0;
		opacity: 0.7;
		font-size: 0.9em;
	}

	html.dark footer {
		border-top: 1px solid rgba(var(--gray), 20%);
	}

	@media (prefers-color-scheme: dark) {
		html:not(.light) footer {
			border-top: 1px solid rgba(var(--gray), 20%);
		}
	}
</style>
