---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
// Compare with trailing slashes stripped so hrefs like "/blog/" match
// both "/blog/" itself and child paths like "/blog/some-post/".
const norm = (s: unknown) => String(s).replace(/\/+$/, '') || '/';
const isActive = norm(href) === norm(pathname) || norm(href) === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
