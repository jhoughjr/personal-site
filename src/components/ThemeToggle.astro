---
// Theme toggle button for manual theme switching
---

<button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
	<span class="icon light-icon">☀️</span>
	<span class="icon dark-icon">🌙</span>
</button>

<script>
	const toggle = document.getElementById('theme-toggle');

	function applyTheme(isDark: boolean) {
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		document.documentElement.classList.toggle('dark', isDark);
	}

	function getCurrentTheme(): boolean {
		return document.documentElement.classList.contains('dark');
	}

	toggle?.addEventListener('click', () => {
		const isDark = getCurrentTheme();
		applyTheme(!isDark);
	});
</script>

<style>
	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 1.25rem;
	}

	.icon {
		display: inline-block;
		transition: opacity 0.3s;
	}

	.light-icon {
		opacity: var(--icon-opacity-light);
	}

	.dark-icon {
		opacity: var(--icon-opacity-dark);
	}

	:root {
		--icon-opacity-light: 1;
		--icon-opacity-dark: 0;
	}

	html.dark {
		--icon-opacity-light: 0;
		--icon-opacity-dark: 1;
	}
</style>
