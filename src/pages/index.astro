---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Jimmy Hough Jr</h1>
			<p>
				Software developer. I write here now and then — see the
				<a href="/blog/">blog</a> and <a href="/portfolio/">portfolio</a>.
			</p>
			<h2>Things I run</h2>
			<ul>
				<li>
					<a href="https://status.jimmyhoughjr.net">Status</a> — live status
					boards for my projects.
				</li>
				<li>
					<a href="https://watts.jimmyhoughjr.net">Watts</a> — an electric
					usage cost calculator: enter your rate, see what your appliances
					cost to run.
				</li>
				<li>
					<a href="https://head2head.jimmyhoughjr.net">head2head</a> — measured
					implementation shootouts on my home server. First bout: the same
					service in Node vs Swift/Hummingbird 2.
				</li>
				<li>
					<a href="https://docs.jimmyhoughjr.net">Roost</a> — the platform all
					of this runs on: one small box, Dokku, a Cloudflare tunnel, and one
					command from nothing to a live app. Copy the pattern
					(<a href="https://github.com/jhoughjr/roost">source</a>).
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
