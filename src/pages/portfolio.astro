---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const projects = await getCollection('portfolio');

// Fetched at build time — the list refreshes on each deploy.
const GH_USER = 'jhoughjr';
interface Repo {
	name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	stargazers_count: number;
	forks_count: number;
	open_issues_count: number;
	size: number; // KB
	created_at: string;
	pushed_at: string;
	fork: boolean;
	langs?: { name: string; pct: number }[];
}
let repos: Repo[] = [];
try {
	const res = await fetch(`https://api.github.com/users/${GH_USER}/repos?per_page=100&type=owner`);
	if (res.ok) {
		repos = ((await res.json()) as Repo[])
			.filter((r) => !r.fork)
			.sort((a, b) => Date.parse(b.pushed_at) - Date.parse(a.pushed_at));
	}
} catch {
	// Offline or rate-limited build: the page still ships, with a profile link below.
}

// One /languages call per repo (~44/build, under the unauthenticated 60/hr
// limit), fetched sequentially — a concurrent burst trips GitHub's secondary
// rate limit. Any failure just drops that repo's language bar, never the build.
for (const repo of repos) {
	try {
		let res = await fetch(`https://api.github.com/repos/${GH_USER}/${repo.name}/languages`);
		if (res.status === 403 || res.status === 429) {
			const wait = Number(res.headers.get('retry-after')) || 30;
			await new Promise((r) => setTimeout(r, wait * 1000));
			res = await fetch(`https://api.github.com/repos/${GH_USER}/${repo.name}/languages`);
		}
		if (res.ok) {
			const bytes = (await res.json()) as Record<string, number>;
			const total = Object.values(bytes).reduce((s, b) => s + b, 0);
			if (total) {
				const entries = Object.entries(bytes)
					.sort((a, b) => b[1] - a[1])
					.map(([name, b]) => ({ name, pct: (b / total) * 100 }));
				const top = entries.filter((e, i) => i < 3 && e.pct >= 1);
				const rest = 100 - top.reduce((s, e) => s + e.pct, 0);
				repo.langs = rest >= 1 ? [...top, { name: 'Other', pct: rest }] : top;
			}
		}
	} catch {
		/* skip bar for this repo */
	}
}

const LANG_COLORS: Record<string, string> = {
	Swift: '#f05138', Python: '#3572a5', 'C++': '#f34b7d', C: '#555555',
	'Objective-C': '#438eff', HTML: '#e34c26', CSS: '#663399', JavaScript: '#f1e05a',
	TypeScript: '#3178c6', Shell: '#89e051', AppleScript: '#101f1f', Astro: '#ff5a03',
	Rust: '#dea584', Ruby: '#701516', Dockerfile: '#384d54', Makefile: '#427819',
	Other: '#9a9a9a',
};
const langColor = (name: string) => LANG_COLORS[name] ?? '#9a9a9a';

const fmtDate = (iso: string) =>
	new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const fmtSize = (kb: number) =>
	kb < 1024 ? `${kb} KB` : `${(kb / 1024).toFixed(kb < 10240 ? 1 : 0)} MB`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="Check out my projects" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Portfolio</h1>
				<p>Things I've built:</p>
			</section>
			{projects.length > 0 && (
				<section>
					<h2 class="section-title">Featured</h2>
					<ul class="projects">
						{projects.map((project) => (
							<li class="project-card">
								<a href={`/portfolio/${project.slug}/`}>
									<h2>{project.data.title}</h2>
									<p class="description">{project.data.description}</p>
									{project.data.tags && (
										<div class="tags">
											{project.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
			<section>
				<h2 class="section-title">On GitHub</h2>
				{repos.length > 0 ? (
					<ul class="projects">
						{repos.map((repo) => (
							<li class="project-card">
								<a href={repo.html_url} target="_blank" rel="noopener">
									<h2>{repo.name}</h2>
									{repo.description && <p class="description">{repo.description}</p>}
									{repo.langs && (
										<div class="langs">
											<div class="lang-bar" role="img" aria-label={repo.langs.map((l) => `${l.name} ${Math.round(l.pct)}%`).join(', ')}>
												{repo.langs.map((l) => (
													<span style={`flex-grow:${l.pct};background:${langColor(l.name)}`} />
												))}
											</div>
											<p class="lang-names">
												{repo.langs.map((l) => `${l.name} ${Math.round(l.pct)}%`).join(' · ')}
											</p>
										</div>
									)}
									<p class="repo-stats">
										{repo.stargazers_count > 0 && <span>★ {repo.stargazers_count}</span>}
										{repo.forks_count > 0 && <span>⑂ {repo.forks_count}</span>}
										{repo.open_issues_count > 0 && <span>{repo.open_issues_count} open issues</span>}
										<span>{fmtSize(repo.size)}</span>
										<span>since {new Date(repo.created_at).getFullYear()}</span>
									</p>
									<p class="repo-meta">Updated {fmtDate(repo.pushed_at)}</p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p>
						Couldn't reach GitHub when this page was built — browse my projects at
						<a href={`https://github.com/${GH_USER}`}>github.com/{GH_USER}</a>.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}
	h1 {
		font-size: 2rem;
		font-weight: bold;
		margin: 0;
	}
	.section-title {
		font-size: 1.3rem;
		margin: 2.5rem 0 0;
	}
	.projects {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}
	.project-card {
		border: 1px solid rgba(var(--gray), 30%);
		border-radius: 8px;
		padding: 1.5rem;
		transition: transform 0.2s, box-shadow 0.2s;
		background: var(--bg-color);
	}
	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 4px 12px rgba(var(--black), 0.1);
	}
	.project-card a {
		color: inherit;
		text-decoration: none;
	}
	.project-card h2 {
		font-size: 1.25rem;
		margin: 0 0 0.5rem 0;
		color: var(--text-color);
	}
	.description {
		color: var(--text-color);
		margin: 0 0 1rem 0;
		line-height: 1.5;
		opacity: 0.85;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tag {
		display: inline-block;
		background: rgba(var(--gray), 20%);
		color: var(--text-color);
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.85rem;
	}
	.langs {
		margin: 0.9rem 0 0;
	}
	.lang-bar {
		display: flex;
		gap: 2px;
		height: 6px;
		border-radius: 3px;
		overflow: hidden;
	}
	.lang-bar span {
		min-width: 3px;
	}
	.lang-names {
		margin: 0.35rem 0 0;
		font-size: 0.75rem;
		color: var(--text-color);
		opacity: 0.7;
	}
	.repo-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--text-color);
		opacity: 0.75;
	}
	.repo-meta {
		margin: 0.35rem 0 0;
		font-size: 0.8rem;
		color: var(--text-color);
		opacity: 0.6;
	}
</style>
