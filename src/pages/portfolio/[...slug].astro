---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('portfolio');
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${project.data.title} | ${SITE_TITLE}`} description={project.data.description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1 class="title">{project.data.title}</h1>
				<p class="description">{project.data.description}</p>
				{project.data.link && (
					<p class="link">
						<a href={project.data.link} target="_blank" rel="noopener noreferrer">
							View Project →
						</a>
					</p>
				)}
				{project.data.tags && (
					<div class="tags">
						{project.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
				<hr />
				<Content />
			</article>
			<nav>
				<a href="/portfolio">← Back to Portfolio</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
	}
	.title {
		margin: 0 0 1rem 0;
		font-size: 2rem;
		color: var(--text-color);
	}
	.description {
		color: var(--text-color);
		font-size: 1.1rem;
		margin-bottom: 1rem;
		opacity: 0.85;
	}
	.link {
		margin-bottom: 1rem;
	}
	.link a {
		color: var(--accent);
		text-decoration: none;
	}
	.link a:hover {
		text-decoration: underline;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}
	.tag {
		display: inline-block;
		background: rgba(var(--gray), 20%);
		color: var(--text-color);
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.85rem;
	}
	hr {
		border: 0;
		border-top: 1px solid rgba(var(--gray), 30%);
		margin: 2rem 0;
	}
	nav {
		margin-top: 2rem;
	}
	nav a {
		color: var(--accent);
		text-decoration: none;
	}
	nav a:hover {
		text-decoration: underline;
	}
</style>
